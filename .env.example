# Web app: no environment variables required.
# Legacy VITE_SUPABASE_* settings are no longer used by the web app.

# PostHog analytics (optional; off by default).
# Also requires explicit user opt-in: localStorage analytics_opt_in=1.
VITE_POSTHOG_KEY=phc_xxxxxxxxxxxxxxxxxxxxx
VITE_POSTHOG_HOST=https://app.posthog.com

# Server-side evals / MCP (optional; never use VITE_ for these secrets).
LLM_API_KEY=
LLM_PROVIDER=openai
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Worker eval mode (optional).
WORKER_URL=https://research.ledring.dev
