{
  "name": "research-thinking-ai",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "eval": "tsx scripts/eval.ts",
    "mcp": "tsx server/mcp.ts",
    "watch": "tsx scripts/watch.ts",
    "typecheck:server": "tsc -p tsconfig.server.json --noEmit",
    "build:worker-check": "tsc -p worker/tsconfig.json --noEmit",
    "typecheck:worker": "tsc -p worker/tsconfig.json --noEmit",
    "deploy": "pnpm build && npx wrangler@3 deploy",
    "db:migrate": "npx wrangler@3 d1 migrations apply research-thinking --remote"
  },
  "dependencies": {
    "@fontsource/fira-code": "^5.3.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@tanstack/react-query": "5.95.2",
    "posthog-js": "1.364.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "10.1.0",
    "react-router-dom": "^6.28.0",
    "remark-gfm": "4.0.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261016.1",
    "@eslint/js": "^9.39.4",
    "@types/node": "^24.12.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.57.0",
    "vite": "^8.0.1",
    "vitest": "^3.2.7"
  }
}
